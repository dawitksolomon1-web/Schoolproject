# Your institution's Canvas root URL — the only required setting.
CANVAS_BASE_URL=https://your-school.instructure.com

# Needed only for draft generation (`python main.py draft --confirm`).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Everything below is optional.
# ---------------------------------------------------------------------------

# The assistant is browser-only by default (it reuses the Chrome session you
# save with `python main.py login`). Canvas API mode stays OFF unless you
# deliberately flip this to 1 and provide a token.
CANVAS_USE_API=0
CANVAS_API_TOKEN=

CANVAS_ASSISTANT_DATA_DIR=./data
CANVAS_ASSISTANT_DRAFT_MODEL=claude-opus-4-8
CANVAS_ASSISTANT_DEADLINE_WARNING_DAYS=7
CANVAS_ASSISTANT_MAX_PAGES_PER_COURSE=25
