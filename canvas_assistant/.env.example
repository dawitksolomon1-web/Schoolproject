# Canvas API access (preferred connection method).
# CANVAS_BASE_URL is your institution's Canvas root, e.g. https://canvas.university.edu
CANVAS_BASE_URL=https://your-school.instructure.com
# Generate at Canvas > Account > Settings > + New Access Token
CANVAS_API_TOKEN=

# Only needed if CANVAS_API_TOKEN is unavailable and you rely on the
# Playwright login fallback (read-only browsing/downloading, never submission).
CANVAS_USERNAME=
CANVAS_PASSWORD=

# Used to generate draft solutions, quiz study notes, and summaries.
ANTHROPIC_API_KEY=

# Optional overrides
CANVAS_ASSISTANT_DATA_DIR=./data
CANVAS_ASSISTANT_DRAFT_MODEL=claude-opus-4-8
CANVAS_ASSISTANT_DEADLINE_WARNING_DAYS=7
